        "text": "=\u2705 Backup OK: {{ $json.host }} \u2014 uploaded {{ $json.uploadedHuman }}, {{ $json.sizeHuman }} total in R2.{{ $json.umountWarning ? '\\n\u26a0\ufe0f ' + $json.umountWarning : '' }}",
        "additionalFields": {}
